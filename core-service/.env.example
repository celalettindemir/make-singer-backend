# Server Configuration
SERVER_PORT=8000
SERVER_ENV=development

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limits
RATELIMIT_LYRICS_PER_MIN=30
RATELIMIT_RENDER_PER_HOUR=5
RATELIMIT_MASTER_PER_HOUR=10
RATELIMIT_EXPORT_PER_HOUR=20
RATELIMIT_UPLOAD_PER_HOUR=50
# POST /api/social/yayinlar, per user per hour
RATELIMIT_SOSYAL_YAYIN_PER_HOUR=30
# POST /api/social/yayinlar/{id}/yorumlar, per user per minute (429 yavasla)
RATELIMIT_SOSYAL_YORUM_PER_MIN=10
# POST /api/social/yayinlar/{id}/cover-baslat, per user per hour
RATELIMIT_SOSYAL_COVER_PER_HOUR=20
# GET /api/public/s/{slug} (no session): per client IP per minute
RATELIMIT_PUBLIC_PER_MIN=30
# Same endpoint, shared per-minute limit for requests carrying a correct X-Web-Anahtari (the web server)
RATELIMIT_PUBLIC_WEB_PER_MIN=600
# Per-visitor limit inside web requests (X-Web-Anahtari + X-Ziyaretci-Ip), checked before the shared one; <=0 disables
RATELIMIT_PUBLIC_WEB_VISITOR_PER_MIN=30
RATELIMIT_PURCHASES_PER_MIN=20
RATELIMIT_WEBHOOKS_PER_MIN=120
# Cloudflare edge ranges (comma-separated CIDRs): CF-Connecting-IP is trusted for per-IP limits only when the
# peer (Traefik X-Real-Ip) is inside them. Unset = built-in Cloudflare list; empty value = header never trusted.
# An invalid entry stops the server at startup.
# RATELIMIT_CLOUDFLARE_RANGES=

# Discover web key: the X-Web-Anahtari header of make-singer-frontend.
# If empty, the web server is also subject to the per-IP limit. It is a secret: in production it is
# read from a Docker secret via SOSYAL_WEB_ANAHTARI_FILE. Use a random value of at least 32
# characters (e.g. openssl rand -hex 32).
SOSYAL_WEB_ANAHTARI=
# Publications stuck in "preparing" (lost prepare job) are failed by a periodic sweep so the
# owner can retry. A sweep interval <= 0 (e.g. 0s) disables the scheduler.
SOCIAL_STALE_PREPARATION_AFTER=1h
SOCIAL_STALE_SWEEP_INTERVAL=15m

# Credits (CREDITS_ENFORCE=false: no deduction yet)
CREDITS_ENFORCE=false
CREDITS_WELCOME=24
CREDITS_PLAN_MONTHLY=300
CREDITS_COST_RENDER_MIX=12
CREDITS_COST_RENDER_FOCUS=32
CREDITS_COST_RENDER_STEMS=62
CREDITS_COST_LYRICS_GENERATE=2
CREDITS_COST_LYRICS_REWRITE=1
CREDITS_REFILL_INTERVAL=1h

# Apple App Store. APPSTORE_PRODUCT_PREFIX empty = APPSTORE_BUNDLE_ID + "."
# APPSTORE_PRIVATE_KEY is a secret (also readable via APPSTORE_PRIVATE_KEY_FILE).
APPSTORE_BUNDLE_ID=
APPSTORE_PRODUCT_PREFIX=
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=

# Google Play. GOOGLEPLAY_SERVICE_ACCOUNT is the secret JSON (also via GOOGLEPLAY_SERVICE_ACCOUNT_FILE).
GOOGLEPLAY_PACKAGE_NAME=
GOOGLEPLAY_SERVICE_ACCOUNT=
GOOGLEPLAY_PUBSUB_AUDIENCE=
GOOGLEPLAY_PUBSUB_EMAIL=

# Groq AI Configuration
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4000
GROQ_TEMPERATURE_GENERATE=0.8
GROQ_TEMPERATURE_REWRITE=0.6

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_BUCKET=makeasinger-public
R2_PRIVATE_BUCKET=makeasinger-private
R2_PUBLIC_URL=https://makesinger-cdn.celalettindemir.dev
R2_PRESIGN_TTL=1h

# Suno API Configuration
SUNO_API_KEY=your-suno-api-key
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V6
SUNO_CALLBACK_URL=https://makesinger-api.celalettindemir.dev/suno/callback

# Audio Processing Service Configuration
AUDIO_SERVICE_URL=http://audio-service:8084
AUDIO_SERVICE_TIMEOUT=120

# Custom OpenID Provider Configuration
# WARNING: AUTH_SIGNING_KEY (RSA private key) and AUTH_CRYPTO_KEY are secret values
# and must NEVER be committed to version control. In production, these are provided
# via Kubernetes secrets with sops encryption. Do NOT put real keys/secrets below.
AUTH_ISSUER=https://makesinger-auth.celalettindemir.dev
AUTH_PORT=8001
AUTH_CLIENT_ID=makesinger-mobil
# Whitespace-separated list of allowed redirect URIs
AUTH_REDIRECT_URIS=com.makesinger.app:/oauth2redirect https://makesinger.celalettindemir.dev/oauth2redirect
# PostgreSQL connection string for user database
AUTH_DB_URL=postgres://makesinger_auth:change-me@pg-kiracilar-rw.kiracilar.svc.cluster.local:5432/makesinger_auth?sslmode=require
# Token lifetimes
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=1440h
# RSA private key in PEM format (-----BEGIN RSA PRIVATE KEY-----)
# Must be exactly 2048 bits. NEVER commit the real key; provide via secret.
AUTH_SIGNING_KEY=change-me-real-key-in-secrets
# Encryption key: must be EXACTLY 32 bytes (raw characters, not hex).
# identity.CryptoKey rejects any other length and the service dies with
# log.Fatalf at startup. The placeholder below is exactly 32 bytes so that
# a developer copying this file as-is gets a service that starts.
# This is a PLACEHOLDER, not a real secret: NEVER commit the real key,
# provide it via Kubernetes secrets.
AUTH_CRYPTO_KEY=placeholder-32-bytes-change-me!!

# OpenID Provider rate limits (/giris and /kayit on the OP listener,
# both GET and POST; these endpoints are outside the Fiber middleware
# chain). GET pages are counted on SEPARATE keys from POST so that
# opening the form does not consume the password-attempt budget.
AUTH_LOGIN_IP_PER_MIN=10
AUTH_LOGIN_EMAIL_PER_HOUR=60
AUTH_SIGNUP_IP_PER_HOUR=5
# Number of TRUSTED reverse proxies in front of the OP listener.
# Determines how X-Forwarded-For is read: the Nth element FROM THE RIGHT
# is taken as the client address.
# DEFAULT 0 = the header is NEVER read, RemoteAddr is used. This is the
# fail-safe side: with no proxy in front, 1 would trust a single-element
# forged X-Forwarded-For and an attacker could write a different IP on
# every request, bypassing the IP rate limit entirely.
# MUST be set EXPLICITLY to the real proxy count when running behind a
# reverse proxy such as Traefik (Traefik only => 1).
AUTH_TRUSTED_PROXIES=0

# --- Federation (Phase 2). If empty, the Apple/Google buttons are hidden. ---
# Google: https://console.cloud.google.com -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: https://makesinger-auth.celalettindemir.dev/federasyon/google/geri
AUTH_FED_GOOGLE_CLIENT_ID=
AUTH_FED_GOOGLE_CLIENT_SECRET=
# Apple: Services ID + Sign in with Apple key (.p8)
# Return URL: https://makesinger-auth.celalettindemir.dev/federasyon/apple/geri
AUTH_FED_APPLE_CLIENT_ID=
AUTH_FED_APPLE_TEAM_ID=
AUTH_FED_APPLE_KEY_ID=
AUTH_FED_APPLE_KEY_P8=
